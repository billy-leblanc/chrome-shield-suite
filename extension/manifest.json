{
  "manifest_version": 3,
  "name": "Safety Intercept",
  "version": "1.0.0",
  "description": "AI-powered payment fraud detection. Protects you from scams on PayPal, Venmo, Zelle, and major banks in real time.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "*://*.paypal.com/*",
    "*://*.venmo.com/*",
    "*://*.zellepay.com/*",
    "*://*.hsbc.co.uk/*",
    "*://*.barclays.co.uk/*",
    "*://*.revolut.com/*",
    "*://*.wellsfargo.com/*",
    "*://*.chase.com/*",
    "*://*.bankofamerica.com/*",
    "*://*.citi.com/*",
    "*://mail.google.com/*",
    "https://*.workers.dev/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.paypal.com/*",
        "*://*.venmo.com/*",
        "*://*.zellepay.com/*",
        "*://*.hsbc.co.uk/*",
        "*://*.barclays.co.uk/*",
        "*://*.revolut.com/*",
        "*://*.wellsfargo.com/*",
        "*://*.chase.com/*",
        "*://*.bankofamerica.com/*",
        "*://*.citi.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["*://mail.google.com/*"],
      "js": ["gmail-content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
